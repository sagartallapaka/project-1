# Application
APP_NAME="AutoRecruiter AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="your-secret-key-change-in-production"

# API Configuration
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/autorecruiter"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# AI/ML API Keys
OPENAI_API_KEY="sk-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
HUGGINGFACE_API_KEY="hf_your-huggingface-key"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@autorecruiter.ai"
EMAIL_FROM_NAME="AutoRecruiter AI"

# JWT Authentication
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Calendar Integration
GOOGLE_CALENDAR_CREDENTIALS_PATH="./config/google_credentials.json"
GOOGLE_CALENDAR_TOKEN_PATH="./config/google_token.json"

# Job Portal API Keys
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
NAUKRI_API_KEY="your-naukri-api-key"
INDEED_PUBLISHER_ID="your-indeed-publisher-id"
INDEED_CLIENT_ID="your-indeed-client-id"
INTERNSHALA_API_KEY="your-internshala-api-key"

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_RESUME_FORMATS=["pdf","docx","doc","txt"]
UPLOAD_DIR="./uploads"

# Security
ALLOWED_HOSTS=["localhost","127.0.0.1"]
RATE_LIMIT_PER_MINUTE=60

# Privacy & Compliance
DATA_RETENTION_DAYS=365
ENABLE_PII_ANONYMIZATION=True
GDPR_COMPLIANCE_MODE=True

# Monitoring
ENABLE_METRICS=True
PROMETHEUS_PORT=9090
LOG_LEVEL="INFO"

# Model Configuration
RESUME_PARSER_MODEL="en_core_web_sm"
SENTENCE_TRANSFORMER_MODEL="all-MiniLM-L6-v2"
RANKING_MODEL_PATH="./models/ranking_model.pkl"

# Agent Configuration
FAKE_DETECTION_THRESHOLD=0.7
MATCHING_SCORE_THRESHOLD=60
MAX_CANDIDATES_PER_JOB=100

# Chatbot
CHATBOT_MODEL="gpt-4-turbo-preview"
CHATBOT_MAX_TOKENS=500
CHATBOT_TEMPERATURE=0.7
